// --- Definição dos Pinos ---
const int pinoTrig = 9;     // Pino de Gatilho do sensor
const int pinoEcho = 10;    // Pino de Eco do sensor

const int ledVermelho = 2;  // Pino do LED Vermelho
const int ledAmarelo = 3;   // Pino do LED Amarelo
const int ledVerde = 4;     // Pino do LED Verde

// --- Variáveis para armazenar valores ---
long duracao;
int distancia;

void setup() {
  // Inicia a comunicação serial (para ver a distância no computador)
  Serial.begin(9600);

  // Define os pinos do sensor
  pinMode(pinoTrig, OUTPUT);
  pinMode(pinoEcho, INPUT);

  // Define os pinos dos LEDs como saída
  pinMode(ledVermelho, OUTPUT);
  pinMode(ledAmarelo, OUTPUT);
  pinMode(ledVerde, OUTPUT);
}

void loop() {
  // --- 1. Faz a leitura do sensor ---
  // Limpa o pino de Trigger
  digitalWrite(pinoTrig, LOW);
  delayMicroseconds(2);
  
  // Envia um pulso de 10 microsegundos
  digitalWrite(pinoTrig, HIGH);
  delayMicroseconds(10);
  digitalWrite(pinoTrig, LOW);
  
  // Lê o tempo de retorno do som no pino Echo
  duracao = pulseIn(pinoEcho, HIGH);
  
  // Calcula a distância em centímetros
  // (Velocidade do som = 0.034 cm/us)
  distancia = duracao * 0.034 / 2;

  // Mostra a distância no Monitor Serial (opcional, para testes)
  Serial.print("Distancia: ");
  Serial.print(distancia);
  Serial.println(" cm");

  // --- 2. Lógica dos LEDs (Distâncias) ---
  
  // PERIGO: Muito perto (Menor que 10 cm) -> Acende Vermelho
  if (distancia < 10) {
    digitalWrite(ledVermelho, HIGH);
    digitalWrite(ledAmarelo, LOW);
    digitalWrite(ledVerde, LOW);
  }
  // ALERTA: Aproximando (Entre 10 cm e 30 cm) -> Acende Amarelo
  else if (distancia >= 10 && distancia < 30) {
    digitalWrite(ledVermelho, LOW);
    digitalWrite(ledAmarelo, HIGH);
    digitalWrite(ledVerde, LOW);
  }
  // SEGURO: Longe (Maior ou igual a 30 cm) -> Acende Verde
  else {
    digitalWrite(ledVermelho, LOW);
    digitalWrite(ledAmarelo, LOW);
    digitalWrite(ledVerde, HIGH);
  }

  // Pequena pausa para estabilidade
  delay(100);
}
